{
  "items": [
    {
      "id": "g001",
      "pattern": "～ようだ / ～みたいだ",
      "meaning": "~인 것 같다 (추측·비유)",
      "connection": "동사 보통형 + ようだ / 명사 + のようだ / 명사 + みたいだ",
      "explanation": "직접 본 모습이나 들은 정보를 근거로 화자가 추측할 때 쓴다. みたいだ는 회화체.",
      "examples": [
        {
          "jp": "彼は風邪をひいているようだ。",
          "ko": "그는 감기에 걸린 것 같다."
        },
        {
          "jp": "夢みたいだ。",
          "ko": "꿈 같다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g002",
      "pattern": "～らしい",
      "meaning": "~인 듯하다 (전문)",
      "connection": "보통형 + らしい",
      "explanation": "들은 정보·뉴스를 전할 때 자주 쓴다. ようだ보다 객관적.",
      "examples": [
        {
          "jp": "明日は雨が降るらしい。",
          "ko": "내일은 비가 온다는 것 같다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g003",
      "pattern": "～そうだ (양태)",
      "meaning": "~할 것 같다 (눈으로 본 인상)",
      "connection": "동사 ます형 / 형용사 어간 + そうだ",
      "explanation": "겉모습을 보고 그렇게 보인다고 추측할 때. ない는 なさそう로 변형.",
      "examples": [
        {
          "jp": "このケーキ、おいしそう!",
          "ko": "이 케이크 맛있어 보여!"
        },
        {
          "jp": "雨が降りそうだ。",
          "ko": "비가 올 것 같다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g004",
      "pattern": "～はずだ",
      "meaning": "~할 터이다 (당연한 결과·근거 있는 확신)",
      "connection": "보통형 + はずだ (な형용사·명사는 な/の)",
      "explanation": "근거가 있어 당연히 그렇다고 판단할 때 사용.",
      "examples": [
        {
          "jp": "彼は来るはずだ。",
          "ko": "그는 올 것이다 (당연히)."
        },
        {
          "jp": "連絡したから、知っているはずだ。",
          "ko": "연락했으니까 알고 있을 거다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g005",
      "pattern": "～かもしれない",
      "meaning": "~일지도 모른다",
      "connection": "보통형 + かもしれない",
      "explanation": "가능성이 있다는 약한 추측.",
      "examples": [
        {
          "jp": "明日は休みかもしれない。",
          "ko": "내일은 쉬는 날일지도 모른다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g006",
      "pattern": "～ので",
      "meaning": "~이기 때문에 (정중한 이유)",
      "connection": "보통형 + ので (な형용사·명사는 な/+な)",
      "explanation": "から보다 객관적·정중하다. 의뢰·사과에 자주.",
      "examples": [
        {
          "jp": "頭が痛いので、休みます。",
          "ko": "머리가 아파서 쉬겠습니다."
        }
      ],
      "category": "원인이유"
    },
    {
      "id": "g007",
      "pattern": "～から",
      "meaning": "~이니까",
      "connection": "보통형/정중형 + から",
      "explanation": "주관적 이유. 결론·결심을 말할 때 자연스럽다.",
      "examples": [
        {
          "jp": "忙しいから、後でね。",
          "ko": "바쁘니까 나중에."
        }
      ],
      "category": "원인이유"
    },
    {
      "id": "g008",
      "pattern": "～ために",
      "meaning": "~을 위해 / ~ 때문에",
      "connection": "동사 사전형/명사 の + ために",
      "explanation": "두 의미 모두 가능. 목적이거나 원인.",
      "examples": [
        {
          "jp": "健康のために運動する。",
          "ko": "건강을 위해 운동한다."
        },
        {
          "jp": "雨のために中止になった。",
          "ko": "비 때문에 중지되었다."
        }
      ],
      "category": "원인이유"
    },
    {
      "id": "g009",
      "pattern": "～おかげで / ～せいで",
      "meaning": "~덕분에 / ~탓에",
      "connection": "보통형 + おかげで / せいで",
      "explanation": "긍정 결과는 おかげで, 부정 결과는 せいで.",
      "examples": [
        {
          "jp": "先生のおかげで合格した。",
          "ko": "선생님 덕분에 합격했다."
        },
        {
          "jp": "雨のせいで遅れた。",
          "ko": "비 탓에 늦었다."
        }
      ],
      "category": "원인이유"
    },
    {
      "id": "g010",
      "pattern": "～のに",
      "meaning": "~인데도 (역접·불만)",
      "connection": "보통형 + のに",
      "explanation": "기대와 다른 결과. 가벼운 불만·아쉬움을 포함.",
      "examples": [
        {
          "jp": "勉強したのに、点数が悪かった。",
          "ko": "공부했는데도 점수가 나빴다."
        }
      ],
      "category": "역접양보"
    },
    {
      "id": "g011",
      "pattern": "～ても / ～でも",
      "meaning": "~해도",
      "connection": "동사 て형 + も / な형용사·명사 + でも",
      "explanation": "역접의 가정.",
      "examples": [
        {
          "jp": "雨が降っても行きます。",
          "ko": "비가 와도 갑니다."
        }
      ],
      "category": "역접양보"
    },
    {
      "id": "g012",
      "pattern": "～くせに",
      "meaning": "~인 주제에",
      "connection": "보통형 + くせに",
      "explanation": "비난·불만이 섞인 표현. 친한 사이에서만.",
      "examples": [
        {
          "jp": "知らないくせに、言うな。",
          "ko": "모르는 주제에 말하지 마."
        }
      ],
      "category": "역접양보"
    },
    {
      "id": "g013",
      "pattern": "～ようになる",
      "meaning": "~하게 되다 (능력·습관의 변화)",
      "connection": "동사 사전형/ない형 + ようになる",
      "explanation": "전에는 못/안 했지만 이제는 한다는 변화.",
      "examples": [
        {
          "jp": "日本語が話せるようになった。",
          "ko": "일본어를 말할 수 있게 되었다."
        }
      ],
      "category": "변화"
    },
    {
      "id": "g014",
      "pattern": "～ようにする",
      "meaning": "~하도록 하다 (노력·습관)",
      "connection": "동사 사전형/ない형 + ようにする",
      "explanation": "의식적으로 그렇게 행동하려는 노력.",
      "examples": [
        {
          "jp": "毎日運動するようにしている。",
          "ko": "매일 운동하려고 하고 있다."
        }
      ],
      "category": "변화"
    },
    {
      "id": "g015",
      "pattern": "～ことになる / ～ことにする",
      "meaning": "~하게 되다 / ~하기로 하다",
      "connection": "동사 사전형/ない형 + ことになる/ことにする",
      "explanation": "なる는 외부 결정, する는 본인 결정.",
      "examples": [
        {
          "jp": "来月から大阪に転勤することになった。",
          "ko": "다음 달부터 오사카로 전근하게 되었다."
        },
        {
          "jp": "明日から早起きすることにした。",
          "ko": "내일부터 일찍 일어나기로 했다."
        }
      ],
      "category": "변화"
    },
    {
      "id": "g016",
      "pattern": "～(ら)れる (수동)",
      "meaning": "~당하다 / ~받다",
      "connection": "1그룹: ない형 + れる / 2그룹: る → られる",
      "explanation": "직접·간접·피해의 수동을 표현.",
      "examples": [
        {
          "jp": "先生に褒められた。",
          "ko": "선생님께 칭찬받았다."
        },
        {
          "jp": "雨に降られた。",
          "ko": "비를 맞았다 (피해)."
        }
      ],
      "category": "수동사역"
    },
    {
      "id": "g017",
      "pattern": "～(さ)せる (사역)",
      "meaning": "~시키다 / ~하게 하다",
      "connection": "1그룹: ない형 + せる / 2그룹: る → させる",
      "explanation": "강제·허가 두 의미 모두.",
      "examples": [
        {
          "jp": "子どもに野菜を食べさせた。",
          "ko": "아이에게 채소를 먹게 했다."
        }
      ],
      "category": "수동사역"
    },
    {
      "id": "g018",
      "pattern": "～(さ)せられる (사역수동)",
      "meaning": "(어쩔 수 없이) ~당하다",
      "connection": "사역형 + られる",
      "explanation": "원치 않게 하게 됨. 1그룹은 ～される로 축약 가능.",
      "examples": [
        {
          "jp": "先輩にお酒を飲まされた。",
          "ko": "선배가 술을 마시게 했다 (싫었지만)."
        }
      ],
      "category": "수동사역"
    },
    {
      "id": "g019",
      "pattern": "～ば / ～たら / ～なら / ～と",
      "meaning": "~하면 (네 가지 조건)",
      "connection": "각 활용형",
      "explanation": "ば는 일반 조건, たら는 개별 조건·완료 후, なら는 화제 한정, と는 자연·필연.",
      "examples": [
        {
          "jp": "春になれば桜が咲く。",
          "ko": "봄이 되면 벚꽃이 핀다."
        },
        {
          "jp": "駅に着いたら電話して。",
          "ko": "역에 도착하면 전화해."
        },
        {
          "jp": "行くなら早めに。",
          "ko": "갈 거라면 일찍."
        },
        {
          "jp": "ボタンを押すと開く。",
          "ko": "버튼을 누르면 열린다."
        }
      ],
      "category": "조건"
    },
    {
      "id": "g020",
      "pattern": "～ながら",
      "meaning": "~하면서",
      "connection": "동사 ます형 + ながら",
      "explanation": "두 동작의 동시 진행.",
      "examples": [
        {
          "jp": "音楽を聞きながら勉強する。",
          "ko": "음악을 들으면서 공부한다."
        }
      ],
      "category": "시간"
    },
    {
      "id": "g021",
      "pattern": "～間に",
      "meaning": "~하는 동안에",
      "connection": "동사 사전형·て いる/명사+の + 間に",
      "explanation": "어떤 기간 안에 한 번의 동작이 일어남.",
      "examples": [
        {
          "jp": "子どもが寝ている間に掃除した。",
          "ko": "아이가 자는 동안에 청소했다."
        }
      ],
      "category": "시간"
    },
    {
      "id": "g022",
      "pattern": "～たばかり",
      "meaning": "막 ~한 참",
      "connection": "동사 た형 + ばかり",
      "explanation": "어떤 동작이 끝난 직후라는 화자의 느낌.",
      "examples": [
        {
          "jp": "今、起きたばかりです。",
          "ko": "지금 막 일어났습니다."
        }
      ],
      "category": "시간"
    },
    {
      "id": "g023",
      "pattern": "～ところ",
      "meaning": "막 ~하려는/하고 있는/한 참",
      "connection": "사전형 + ところ / て いる + ところ / た + ところ",
      "explanation": "현재 시점과의 거리감을 정확히 나타냄.",
      "examples": [
        {
          "jp": "今から出るところです。",
          "ko": "지금 막 나가려는 참입니다."
        }
      ],
      "category": "시간"
    },
    {
      "id": "g024",
      "pattern": "～てから",
      "meaning": "~하고 나서",
      "connection": "동사 て형 + から",
      "explanation": "앞 동작 완료 후 다음 동작.",
      "examples": [
        {
          "jp": "宿題をしてから遊ぶ。",
          "ko": "숙제를 하고 나서 논다."
        }
      ],
      "category": "시간"
    },
    {
      "id": "g025",
      "pattern": "～ばかりでなく",
      "meaning": "~뿐만 아니라",
      "connection": "보통형 + ばかりでなく",
      "explanation": "추가 정보. だけでなく와 비슷.",
      "examples": [
        {
          "jp": "英語ばかりでなく、フランス語もできる。",
          "ko": "영어뿐만 아니라 프랑스어도 가능하다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g026",
      "pattern": "～について",
      "meaning": "~에 대해",
      "connection": "명사 + について",
      "explanation": "주제를 도입할 때.",
      "examples": [
        {
          "jp": "日本の文化について話す。",
          "ko": "일본 문화에 대해 이야기하다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g027",
      "pattern": "～によって",
      "meaning": "~에 의해 / ~에 따라",
      "connection": "명사 + によって",
      "explanation": "수단·원인·차이를 모두 나타냄.",
      "examples": [
        {
          "jp": "国によって文化が違う。",
          "ko": "나라에 따라 문화가 다르다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g028",
      "pattern": "～がる",
      "meaning": "(남이) ~해 하다",
      "connection": "감정형용사 어간 + がる",
      "explanation": "3인칭의 감정을 객관적으로 표현.",
      "examples": [
        {
          "jp": "子どもが寒がっている。",
          "ko": "아이가 추워하고 있다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g029",
      "pattern": "～ばよかった",
      "meaning": "~할 걸 (후회)",
      "connection": "동사 ば형 + よかった",
      "explanation": "안 한 일에 대한 후회.",
      "examples": [
        {
          "jp": "もっと勉強すればよかった。",
          "ko": "더 공부할 걸."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g030",
      "pattern": "～ことがある",
      "meaning": "~한 적이 있다 / ~할 때가 있다",
      "connection": "た형 + ことがある / 사전형 + ことがある",
      "explanation": "경험은 た형, 가끔 있는 일은 사전형.",
      "examples": [
        {
          "jp": "日本に行ったことがある。",
          "ko": "일본에 가 본 적이 있다."
        },
        {
          "jp": "たまに失敗することがある。",
          "ko": "가끔 실수할 때가 있다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g031",
      "pattern": "～てしまう",
      "meaning": "~해 버리다 (완료·후회)",
      "connection": "동사 て형 + しまう",
      "explanation": "완료의 강조나 후회·아쉬움.",
      "examples": [
        {
          "jp": "全部食べてしまった。",
          "ko": "다 먹어 버렸다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g032",
      "pattern": "～ておく",
      "meaning": "~해 두다",
      "connection": "동사 て형 + おく",
      "explanation": "사전 준비. 회화에서 ～とく로 축약.",
      "examples": [
        {
          "jp": "明日の準備をしておく。",
          "ko": "내일 준비를 해 둔다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g033",
      "pattern": "～たほうがいい",
      "meaning": "~하는 게 좋다",
      "connection": "동사 た형 + ほうがいい",
      "explanation": "조언. 부정은 ない + ほうがいい.",
      "examples": [
        {
          "jp": "早く寝たほうがいいよ。",
          "ko": "빨리 자는 게 좋아."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g034",
      "pattern": "～なければならない",
      "meaning": "~하지 않으면 안 된다",
      "connection": "ない형 어간 + なければならない",
      "explanation": "의무. 회화: なきゃ/ないと.",
      "examples": [
        {
          "jp": "明日までに出さなければならない。",
          "ko": "내일까지 제출하지 않으면 안 된다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g035",
      "pattern": "～なくてもいい",
      "meaning": "~하지 않아도 된다",
      "connection": "ない형 어간 + なくてもいい",
      "explanation": "불필요. 허락.",
      "examples": [
        {
          "jp": "無理しなくてもいいよ。",
          "ko": "무리하지 않아도 돼."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g036",
      "pattern": "～かどうか",
      "meaning": "~인지 (아닌지)",
      "connection": "보통형 + かどうか",
      "explanation": "예/아니오 의문을 종속절로.",
      "examples": [
        {
          "jp": "行くかどうかまだ分からない。",
          "ko": "갈지 안 갈지 아직 모른다."
        }
      ],
      "category": "기타"
    },
    {
      "id": "g037",
      "pattern": "～かもしれない vs ～にちがいない",
      "meaning": "일지도 모른다 vs 분명히 ~일 것이다",
      "connection": "보통형 + 각각",
      "explanation": "확신의 정도가 정반대. にちがいない는 거의 확정.",
      "examples": [
        {
          "jp": "彼は嘘をついているにちがいない。",
          "ko": "그는 분명히 거짓말하고 있다."
        }
      ],
      "category": "추측"
    },
    {
      "id": "g038",
      "pattern": "～までに / ～まで",
      "meaning": "~까지 (기한) / ~까지 (계속)",
      "connection": "명사·시간 표현 + までに/まで",
